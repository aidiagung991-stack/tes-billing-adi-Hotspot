# ============================================================================
# Adi_Hotspot Billing - Environment Configuration Example
# Salin file ini menjadi .env pada server Ubuntu:
#   cp .env.example .env
# Kemudian sesuaikan nilai DB_PASSWORD dan kredensial lainnya.
# JANGAN PERNAH menyimpan password asli ke repository git.
# ============================================================================

# SERVER (Express)
# HOST 0.0.0.0 diperlukan agar perangkat lain di LAN dapat mengakses aplikasi.
# Karena aplikasi tidak memakai login sesuai keputusan pemilik, JANGAN buka port ini ke internet.
HOST=0.0.0.0
PORT=3000

# ----------------------------------------------------------------------------
# POSTGRESQL DATABASE CONFIGURATION (Ubuntu Server 24.04 LTS)
# ----------------------------------------------------------------------------
# Host database PostgreSQL (IP internal server database atau localhost)
DB_HOST="127.0.0.1"

# Port PostgreSQL standar
DB_PORT="5432"

# Nama database yang telah dibuat di PostgreSQL
DB_NAME="adi_hotspot"

# Username role PostgreSQL yang memiliki hak akses ke database adi_hotspot
DB_USER="adi_app"

# Password database user adi_app (Wajib diisi pada file .env di server Ubuntu Anda)
DB_PASSWORD="your_postgres_password_here"

# ----------------------------------------------------------------------------
# WABLAS WHATSAPP GATEWAY (Server-Side Secrets)
# ----------------------------------------------------------------------------
# Base API domain Wablas (contoh: https://smg.wablas.com)
WABLAS_SERVER_URL="https://smg.wablas.com"

# API Token rahasia Wablas (diperoleh dari menu Device Dashboard Wablas)
WABLAS_API_TOKEN="MY_WABLAS_API_TOKEN"

# Secret Key Wablas (diperoleh dari menu Setting Device Wablas)
WABLAS_SECRET_KEY=""

# Nomor WhatsApp pengirim yang terhubung (contoh: 081234567890)
WABLAS_SENDER_PHONE=""

# ----------------------------------------------------------------------------
# MIKROTIK ROUTEROS RB4011 REVERSIBLE ENCRYPTION
# Kunci enkripsi rahasia AES-256-GCM untuk mendeskripsi password RouterOS
# ----------------------------------------------------------------------------
MIKROTIK_ENCRYPTION_KEY="your_secure_mikrotik_encryption_passphrase_here"

# ----------------------------------------------------------------------------
# ADMIN AUTHENTICATION (Single Admin - Wajib Diisi di Server Ubuntu)
# JANGAN mengisi password mentah. Hasilkan ADMIN_PASSWORD_HASH secara lokal
# menggunakan perintah: npm run auth:hash
# Gunakan tanda kutip tunggal ('...') agar karakter '$' pada hash bcrypt tidak
# dianggap sebagai variabel oleh shell atau systemd.
# ----------------------------------------------------------------------------
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=''
SESSION_SECRET=""

# Pengaturan Reverse Proxy & Cookie HTTPS (Ubuntu Nginx/Caddy)
# Biarkan TRUST_PROXY="false" jika aplikasi diakses langsung di LAN.
# Gunakan TRUST_PROXY="loopback" HANYA jika berjalan di belakang Nginx/Caddy lokal (127.0.0.1).
TRUST_PROXY="false"
COOKIE_SECURE="auto"

# ----------------------------------------------------------------------------
# AI STUDIO / SYSTEM ENVIRONMENT
# ----------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
