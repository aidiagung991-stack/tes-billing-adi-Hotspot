{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js && esbuild src/server/migrations.ts --bundle --platform=node --format=esm --packages=external --outfile=migrations.js",
    "start": "node server.js",
    "migrate": "tsx src/server/migrations.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js migrations.js",
    "lint": "tsc --noEmit",
    "test": "npm run test:mikrotik && npm run test:auth",
    "test:mikrotik": "tsx src/server/__tests__/mikrotikIntegration.test.ts",
    "test:auth": "tsx src/server/__tests__/authIntegration.test.ts",
    "auth:hash": "tsx src/server/generateAdminHash.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
